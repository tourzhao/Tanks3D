; Godot presentation. Simulation remains owned by the existing C++ core.
config_version=5

[application]
config/name="Tanks 3D — Godot"
config/use_custom_user_dir=true
config/custom_user_dir_name="Tanks3D-Godot"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=1

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/driver.macos="metal"
textures/default_filters/use_nearest_mipmap_filter=false
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=1

[audio]
driver/enable_input=false
